      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\nconst clean = raw.replace(/```json|```/g, '').trim();\n\nlet data = {};\nlet parseOk = true;\ntry {\n  data = JSON.parse(clean);\n} catch (e) {\n  parseOk = false;\n}\n\nconst lead = $('Edit Fields').first().json;\n\nreturn [{\n  json: {\n    name: lead.name,\n    email: lead.email,\n    company: lead.company,\n    message: lead.message,\n    industry: data.industry || 'unknown',\n    company_size_estimate: data.company_size_estimate || 'unknown',\n    summary: data.summary || 'unknown',\n    outreach_hook: data.outreach_hook || 'unknown',\n    lead_score: Number(data.lead_score) || 0,\n    parse_ok: parseOk\n  }\n}];\n"
      },
